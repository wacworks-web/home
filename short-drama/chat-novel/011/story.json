  {"side": "left", "text": "そういう契約なんだよ。気にしないで", "time": "22:45"},
  {"side": "narr", "text": "夫の会社の受付は、無人だ。", "hold": 2.6},
  {"side": "narr", "text": "去年の忘年会で、私はそれを見ている。", "hold": 2.8}
 ],
