 "messages": [
  {"side": "narr", "text": "義実家との同居3年目。毎月8万円を渡している。", "hold": 2.8},
  {"side": "pill", "text": "今日"},
  {"side": "left", "text": "あなた、ご近所で「生活費を入れてる」なんて言ったの？", "time": "17:14"},
  {"side": "right", "text": "事実ですよね？毎月8万、お渡ししています", "time": "17:18", "kidoku": true},
  {"side": "left", "text": "人聞きが悪いわ。うちは住まわせてあげてるのよ", "time": "17:20"},
  {"side": "left", "text": "本当なら家賃15万は取れる家なんだから、感謝してほしいくらい", "time": "17:21"},
  {"side": "right", "text": "では15万で賃貸契約書を作りましょうか。礼金なしで", "time": "17:24", "kidoku": true},
  {"side": "left", "text": "何を言ってるの？", "time": "17:25"},
  {"side": "right", "text": "契約なら、設備の修繕は大家さん負担です。お風呂、壊れてますよ", "time": "17:26", "kidoku": true},
  {"side": "narr", "text": "3年間、修理代はぜんぶ、うちが払ってきた。", "hold": 2.8},
  {"side": "left", "text": "……屁理屈ばっかり。誰に似たのかしら", "time": "17:30"},
  {"side": "narr", "text": "それ以来、「住まわせてあげてる」は聞いていない。", "hold": 3.0}
 ],
 "end_question": ["義実家に同居費、月8万。", "払いすぎ？妥当？"]
}
